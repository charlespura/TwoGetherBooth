PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STUN_URLS=stun:stun.l.google.com:19302
# Optional coturn REST authentication. Set BOTH only on the signaling host.
TURN_URLS=
TURN_SHARED_SECRET=
# 3 hours; covers the room's 2-hour maximum lifetime.
TURN_TTL_SECONDS=10800
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
